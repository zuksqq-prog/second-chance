# ---------------------------------------------------------------------------
# SECOND CHANCE — environment. Copy to .env.local for development.
# Everything here is server-only unless it starts with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Postgres (Neon, Supabase, Railway, RDS, local). Pooled URL is fine.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secondchance

# 32+ random characters. Generate: openssl rand -base64 48
SESSION_SECRET=

# Helius RPC key (https://dashboard.helius.dev). Strongly recommended:
# the public RPC is rate limited and REAL trading refuses to run without a dedicated RPC.
HELIUS_API_KEY=
# Or point at any RPC endpoint directly (overrides HELIUS_API_KEY):
# SOLANA_RPC_URL=

# Jupiter API key (https://developers.jup.ag/portal). Optional for quotes
# (keyless is 0.5 req/s); recommended for execution.
JUPITER_API_KEY=
# JUPITER_BASE_URL=https://api.jup.ag/swap/v2

# ---- Real-money controls (leave disabled until the checklist in STATUS.md is done) ----
REAL_TRADING_ENABLED=false
# Comma-separated wallet addresses allowed to trade real money during the beta.
REAL_TRADING_ALLOWLIST=
# Hard cap per real buy (SOL).
MAX_REAL_TRADE_SOL=0.25
MAX_SLIPPAGE_BPS=2000
MAX_PRIORITY_FEE_LAMPORTS=5000000

# ---- Rewards / cashback (off by default) ----
# Platform fee on real trades via Jupiter's referral program, 50–255 bps (0 = off).
# Users are charged this fee; REWARDS_CASHBACK_PCT of it is credited back to them as claimable SOL.
PLATFORM_FEE_BPS=0
# Your Jupiter referral account (create at referral.jup.ag). Required when PLATFORM_FEE_BPS > 0.
JUPITER_REFERRAL_ACCOUNT=
REWARDS_CASHBACK_PCT=25

# Paper trading starting balance (SOL)
PAPER_STARTING_SOL=10

# Protects /api/cron/reconcile. Vercel Cron sends it automatically when set in project env.
CRON_SECRET=

# Optional: public RPC used only to satisfy the wallet adapter in the browser. Never put a keyed URL here.
# NEXT_PUBLIC_SOLANA_PUBLIC_RPC=https://api.mainnet-beta.solana.com
