{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "src/app/api/trade/real/execute/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/reconcile/route.ts": {
      "maxDuration": 60
    }
  }
}
